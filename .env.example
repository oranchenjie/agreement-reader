# 复制为 .env 后按需修改。所有配置项都是可选的。

# ---------------------------------------------------------------------------
# DeepSeek API Key
# ---------------------------------------------------------------------------
# 【推荐留空】。打开网页后点右上角「模型设置」填写即可：
#   密钥只保存在你自己的浏览器里，每次分析随请求发给本地服务使用，
#   服务端不保存、不写日志、不回显。
#
# 只有在「希望所有访问者共用一把服务端密钥」时才填这里（例如部署给团队用）。
# 优先级：请求里携带的密钥 > 这里的密钥。
DEEPSEEK_API_KEY=

# API 基地址。默认官方地址；指向兼容 OpenAI 协议的自建/代理网关时改这里。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型
#   deepseek-v4-flash  —— 快、便宜，适合逐条扫描（默认）
#   deepseek-v4-pro    —— 更强，适合最终汇总
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_SUMMARY=deepseek-v4-pro

# 服务端口
PORT=8787

# 设为 1 则完全不调用真实 API，只返回本地规则结果（离线演示 / 开发自测）
DSH_AGREEMENT_MOCK=0

# 设为 1 则完全忽略本文件，只用真实环境变量（测试 / CI 用，保证配置来源确定）
# DSH_IGNORE_DOTENV=0

# 并发调用模型的分片数（协议很长时会切成多片并行分析）
ANALYZE_CONCURRENCY=3

# 单个分片的字符上限
ANALYZE_CHUNK_CHARS=6000

# ---------------------------------------------------------------------------
# 模型输出额度（max_tokens）
# ---------------------------------------------------------------------------
# 重要：推理模型（reasoner / pro 类）的 max_tokens 通常**同时覆盖思考过程与正文**。
# 额度不够时会先被思考过程耗尽，表现为 content 为空 + finish_reason=length。
# 这里的默认值比"只算正文"所需宽松得多。
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_MAX_TOKENS_SUMMARY=16384
# 命中"额度耗尽却无正文"时允许自动加倍到这个上限
DEEPSEEK_MAX_TOKENS_CEILING=65536

# ---------------------------------------------------------------------------
# 思考（reasoning）控制 —— 推理模型最容易在这里出问题
# ---------------------------------------------------------------------------
# 推理模型的 max_tokens 同时覆盖「思考过程」与「正文」。额度不够时会先被思考
# 烧光，表现为 content 为空 + finish_reason=length，正文一个字都产不出来。
#   auto（默认）：不传该参数，用服务端默认行为
#   disabled    ：关闭思考，把全部额度留给正文（逐条抽取这类任务推荐）
#   enabled     ：强制开启
# 说明：程序本身也有自适应恢复 —— 一旦检测到"思考烧光额度"，会自动改用
# disabled 重试一次，不需要你手动配置。这里只是让你可以强制指定。
DEEPSEEK_THINKING=auto

# 思考强度（API 的 reasoning_effort）。留空则不传。
# DEEPSEEK_REASONING_EFFORT=low

# 请求超时（毫秒）
DEEPSEEK_TIMEOUT_MS=180000

# 网址抓取上限（字节）与超时
MAX_FETCH_BYTES=8388608
FETCH_TIMEOUT_MS=30000

# 是否允许抓取内网/本机地址。默认禁止（防 SSRF）；本地联调可设 1
ALLOW_PRIVATE_URLS=0

# ---------------------------------------------------------------------------
# JavaScript 渲染兜底
# ---------------------------------------------------------------------------
# 很多网站的协议页是前端渲染的 SPA，静态 HTML 里没有正文。
# 开启后会在抓不到正文时，自动调用本机已安装的 Chrome/Edge 无头渲染一次。
BROWSER_RENDER=1

# 手动指定浏览器可执行文件（留空则自动探测 Chrome / Edge）
# WSL 下示例：BROWSER_BIN=/mnt/c/Program Files/Google/Chrome/Application/chrome.exe
BROWSER_BIN=

# 渲染超时（毫秒）
BROWSER_TIMEOUT_MS=30000

# 抓到的正文少于这个字数，就认为不是完整协议并明确告知用户
MIN_USEFUL_CHARS=300

# ---------------------------------------------------------------------------
# 协议问答的上下文策略
# ---------------------------------------------------------------------------
# auto（默认）：语料放得下就**整篇送给模型**，放不下才退回检索筛选
# full        ：总是整篇送（放不下会报错，提示减少勾选的协议）
# retrieve    ：总是先做检索筛选
#
# 为什么默认整篇送：模型上下文足够大，而检索的字面匹配会替模型下结论 ——
# 用户问「付了钱能退吗」而协议写「不予退还」，检索会一无所获，
# 于是系统错误地回答"协议里没写"。判断权应该归模型。
ASK_CONTEXT_MODE=auto

# 整篇送检的字符上限。给得很大是刻意的：这些模型上下文是 100 万 token，
# 一份协议通常才几万字。限额设小了会退回检索，而检索的字面匹配会替模型下结论。
# 只有语料真的超过这个上限时才退回检索；即使退回，也**绝不会空手拒答** ——
# 检索没命中就把能装下的部分照样送给模型。
ASK_WHOLE_DOC_CHARS=500000
# 退回检索时，送多少个条款、多少字
ASK_TOP_K=8
ASK_MAX_CHARS=20000
# 单次问答的输出上限
DEEPSEEK_MAX_TOKENS_ASK=8192
